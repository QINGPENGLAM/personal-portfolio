# Public build-time endpoints.
# Contact defaults to the configured Web3Forms form; set this only for a custom Worker.
NEXT_PUBLIC_CONTACT_ENDPOINT=
# Leave analytics blank for local-only counts.
NEXT_PUBLIC_ANALYTICS_ENDPOINT=

# Optional GitHub Pages repository base path.
NEXT_PUBLIC_BASE_PATH=

# Optional standalone assistant Worker. Public URL only; never put API keys here.
# Leave empty to keep the local portfolio guide.
NEXT_PUBLIC_ASSISTANT_ENDPOINT=
